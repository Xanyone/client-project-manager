{
  "name": "client-project-manager",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.5",
  "icon": "logo.png",
  "publisher": "Xanyone",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clientProjectDashboard",
          "title": "%views.container.title%",
          "icon": "media/icon.svg",
          "when": "config.clientProjectDashboard.showSidebar"
        }
      ]
    },
    "views": {
      "clientProjectDashboard": [
        {
          "id": "clientProjectDashboard.explorer",
          "name": "%views.groups.name%",
          "icon": "media/icon.svg",
          "when": "config.clientProjectDashboard.showSidebar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clientProjectDashboard.explorer",
        "contents": "%views.welcome%"
      }
    ],
    "commands": [
      {
        "command": "clientProjectDashboard.openDashboard",
        "title": "%commands.openDashboard.title%",
        "category": "%commands.category%",
        "icon": "$(dashboard)"
      },
      {
        "command": "clientProjectDashboard.addClient",
        "title": "%commands.addClient.title%",
        "category": "%commands.category%",
        "icon": "$(add)"
      },
      {
        "command": "clientProjectDashboard.addProject",
        "title": "%commands.addProject.title%",
        "category": "%commands.category%",
        "icon": "$(folder)"
      },
      {
        "command": "clientProjectDashboard.addModule",
        "title": "%commands.addModule.title%",
        "category": "%commands.category%",
        "icon": "$(new-folder)"
      },
      {
        "command": "clientProjectDashboard.rename",
        "title": "%commands.rename.title%",
        "category": "%commands.category%",
        "icon": "$(edit)"
      },
      {
        "command": "clientProjectDashboard.setColor",
        "title": "%commands.setColor.title%",
        "category": "%commands.category%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "clientProjectDashboard.setPath",
        "title": "%commands.setPath.title%",
        "category": "%commands.category%"
      },
      {
        "command": "clientProjectDashboard.setDescription",
        "title": "%commands.setDescription.title%",
        "category": "%commands.category%"
      },
      {
        "command": "clientProjectDashboard.edit",
        "title": "%commands.edit.title%",
        "category": "%commands.category%",
        "icon": "$(edit)"
      },
      {
        "command": "clientProjectDashboard.remove",
        "title": "%commands.remove.title%",
        "category": "%commands.category%",
        "icon": "$(trash)"
      },
      {
        "command": "clientProjectDashboard.open",
        "title": "%commands.open.title%",
        "category": "%commands.category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "clientProjectDashboard.openInNewWindow",
        "title": "%commands.openInNewWindow.title%",
        "category": "%commands.category%",
        "icon": "$(window)"
      },
      {
        "command": "clientProjectDashboard.openWorkspace",
        "title": "%commands.openWorkspace.title%",
        "category": "%commands.category%"
      },
      {
        "command": "clientProjectDashboard.reveal",
        "title": "%commands.reveal.title%",
        "category": "%commands.category%"
      },
      {
        "command": "clientProjectDashboard.copyPath",
        "title": "%commands.copyPath.title%",
        "category": "%commands.category%",
        "icon": "$(copy)"
      },
      {
        "command": "clientProjectDashboard.moveUp",
        "title": "%commands.moveUp.title%",
        "category": "%commands.category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "clientProjectDashboard.moveDown",
        "title": "%commands.moveDown.title%",
        "category": "%commands.category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "clientProjectDashboard.refresh",
        "title": "%commands.refresh.title%",
        "category": "%commands.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "clientProjectDashboard.exportCatalog",
        "title": "%commands.exportCatalog.title%",
        "category": "%commands.category%"
      },
      {
        "command": "clientProjectDashboard.importCatalog",
        "title": "%commands.importCatalog.title%",
        "category": "%commands.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clientProjectDashboard.openDashboard",
          "when": "view == clientProjectDashboard.explorer",
          "group": "navigation@1"
        },
        {
          "command": "clientProjectDashboard.addClient",
          "when": "view == clientProjectDashboard.explorer",
          "group": "navigation@2"
        },
        {
          "command": "clientProjectDashboard.refresh",
          "when": "view == clientProjectDashboard.explorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "clientProjectDashboard.addProject",
          "when": "view == clientProjectDashboard.explorer && viewItem == client",
          "group": "navigation@1"
        },
        {
          "command": "clientProjectDashboard.openWorkspace",
          "when": "view == clientProjectDashboard.explorer && viewItem == client",
          "group": "navigation@2"
        },
        {
          "command": "clientProjectDashboard.addModule",
          "when": "view == clientProjectDashboard.explorer && viewItem == project",
          "group": "navigation@1"
        },
        {
          "command": "clientProjectDashboard.openWorkspace",
          "when": "view == clientProjectDashboard.explorer && viewItem == project",
          "group": "navigation@2"
        },
        {
          "command": "clientProjectDashboard.open",
          "when": "view == clientProjectDashboard.explorer && viewItem == module",
          "group": "navigation@1"
        },
        {
          "command": "clientProjectDashboard.openInNewWindow",
          "when": "view == clientProjectDashboard.explorer && viewItem == module",
          "group": "navigation@2"
        },
        {
          "command": "clientProjectDashboard.reveal",
          "when": "view == clientProjectDashboard.explorer && viewItem == module",
          "group": "navigation@3"
        },
        {
          "command": "clientProjectDashboard.copyPath",
          "when": "view == clientProjectDashboard.explorer && viewItem == module",
          "group": "navigation@4"
        },
        {
          "command": "clientProjectDashboard.rename",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "2_edit@1"
        },
        {
          "command": "clientProjectDashboard.setPath",
          "when": "view == clientProjectDashboard.explorer && viewItem == module",
          "group": "2_edit@2"
        },
        {
          "command": "clientProjectDashboard.setColor",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "2_edit@4"
        },
        {
          "command": "clientProjectDashboard.setDescription",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "2_edit@5"
        },
        {
          "command": "clientProjectDashboard.moveUp",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "3_move@1"
        },
        {
          "command": "clientProjectDashboard.moveDown",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "3_move@2"
        },
        {
          "command": "clientProjectDashboard.remove",
          "when": "view == clientProjectDashboard.explorer && viewItem =~ /^(client|project|module)$/",
          "group": "4_danger@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clientProjectDashboard.openDashboard",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "clientProjectDashboard.openOnStartup": {
          "type": "string",
          "enum": [
            "never",
            "emptyWindow",
            "always"
          ],
          "enumDescriptions": [
            "%settings.openOnStartup.never%",
            "%settings.openOnStartup.emptyWindow%",
            "%settings.openOnStartup.always%"
          ],
          "default": "emptyWindow",
          "description": "%settings.openOnStartup.description%"
        },
        "clientProjectDashboard.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "%settings.openInNewWindow.description%"
        },
        "clientProjectDashboard.showPath": {
          "type": "boolean",
          "default": true,
          "description": "%settings.showPath.description%"
        },
        "clientProjectDashboard.storage": {
          "type": "string",
          "enum": [
            "globalState",
            "settings"
          ],
          "enumDescriptions": [
            "%settings.storage.globalState%",
            "%settings.storage.settings%"
          ],
          "default": "globalState",
          "description": "%settings.storage.description%",
          "scope": "application"
        },
        "clientProjectDashboard.catalog": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "%settings.catalog.description%",
          "scope": "application"
        },
        "clientProjectDashboard.showSidebar": {
          "type": "boolean",
          "default": true,
          "description": "%settings.showSidebar.description%",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src media/dashboard.js --max-warnings 0",
    "test": "vscode-test",
    "package:vsix": "vsce package --no-dependencies",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/catalog.test.js out/test/uniqueness.test.js out/test/dashboard.test.js"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/proper-lockfile": "^4.1.4",
    "@types/sinon": "^22.0.2",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "@azure/msal-node": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xanyone/client-project-manager.git"
  },
  "homepage": "https://github.com/Xanyone/client-project-manager#readme",
  "bugs": {
    "url": "https://github.com/Xanyone/client-project-manager/issues"
  },
  "license": "MIT",
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  }
}
